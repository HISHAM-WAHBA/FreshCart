# Leave as true to use the built-in static demo data (no backend required).
# Works locally and on Vercel without any extra setup.
VITE_USE_MOCK_DATA=true

# Only set this when you want to connect a real backend API.
# When set, the static demo data is disabled automatically.
# VITE_API_BASE_URL=https://your-api.example.com/api/v1
